{
  "name": "nova-exchange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:bundle",
    "dev:sim": "NOVA_MARKET_DATA_SOURCE=simulation next dev",
    "test:live": "VITEST_LIVE=1 vitest run",
    "verify:bundle": "node scripts/verify-client-bundle.mjs",
    "test:e2e:external": "playwright test --config playwright.external.config.ts",
    "venue:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/venue/cli/demo.ts",
    "venue:bench": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/venue/cli/bench.ts",
    "venue:perf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/venue/cli/perf.ts",
    "venue:memory": "node --expose-gc --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/venue/cli/memory.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
