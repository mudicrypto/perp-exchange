# Nova Exchange — server configuration (copy to .env.local). No secrets are required in Milestone 1.

# Market data source: "hyperliquid" (live public data) or "simulation" (synthetic, dev only).
NOVA_MARKET_DATA_SOURCE=hyperliquid
# Hyperliquid network for public market data: "mainnet" or "testnet".
NOVA_HYPERLIQUID_NETWORK=mainnet
# Execution is disabled in Milestone 1; any other value fails startup validation.
NOVA_EXECUTION_MODE=disabled
# Simulation is refused in production builds unless explicitly allowed (e.g. demo/E2E).
NOVA_ALLOW_SIMULATION_IN_PRODUCTION=false
# Simulation only: bearer tokens for simulated RFQ counterparties' API, as id=token[,id=token]
# (tokens >= 24 chars; server-only, never sent to the browser). Unset: desks only auto-quote.
# NOVA_RFQ_COUNTERPARTY_TOKENS=sim-desk-c=replace-with-a-long-random-token
